<RDF xmlns="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
    xmlns:em="http://www.mozilla.org/2004/em-rdf#">

  <Description about="urn:mozilla:install-manifest">
    <em:id>noia-warm-moon-options@halvar666</em:id>
    <em:version>2.1.2a8</em:version>
    <em:name>Noia Warm Moon Options</em:name>
    <em:description>Optional customization for Noia Warm Moon. Incompatible with simultaneously enabled original Noia Moon Options: disable one and restart Pale Moon.</em:description>
    <em:creator>Lootyhoof</em:creator>
    <em:type>2</em:type>
    <em:optionsURL>chrome://noiawarmoptions/content/options.xul</em:optionsURL>

    <em:contributor>David Vincent</em:contributor>
    <em:contributor>Halvar666: Noia Warm Moon adaptation</em:contributor>

    <em:targetApplication>
      <!-- Pale Moon -->
      <Description>
        <em:id>{8de7fcbb-c55c-4fbe-bfc5-fc555c87dbc4}</em:id>
        <em:minVersion>28.6.0</em:minVersion>
        <em:maxVersion>35.*</em:maxVersion>
      </Description>
    </em:targetApplication>

  </Description>
</RDF>
