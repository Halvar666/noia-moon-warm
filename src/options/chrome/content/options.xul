<?xml version="1.0"?>
<?xml-stylesheet href="chrome://global/skin/" type="text/css"?>
<!DOCTYPE prefwindow SYSTEM "chrome://noiawarmoptions/locale/options.dtd">
<prefwindow xmlns="http://www.mozilla.org/keymaster/gatekeeper/there.is.only.xul"
    xmlns:html="http://www.w3.org/1999/xhtml"
  id="noiawarmop"
  type="prefwindow"
  title="&NoiaMoonOptions;"
  onload="noiawarmop.options.init()"
    buttons="extra1"
  buttonlabelextra1="&nmclose;"
  ondialogextra1="window.close();"
>

  <script type="application/x-javascript" src="options.js"/>

  <prefpane>
    <preferences>
      <preference id="noiamoonpersona"  name="lightweightThemes.isThemeSelected" type="bool" instantApply="true"/>
      <preference id="greyRadio" name="extensions.noiawarmop.grey" type="bool" instantApply="true"/>
      <preference id="blueRadio" name="extensions.noiawarmop.blue" type="bool" instantApply="true"/>
      <preference id="DarkRadio" name="extensions.noiawarmop.dark" type="bool" instantApply="true"/>
      <preference id="grey2Radio" name="extensions.noiawarmop.grey2" type="bool" instantApply="true"/>
      <preference id="solidRadio" name="extensions.noiawarmop.solid" type="bool" instantApply="true"/>
      <preference id="shadowRadio" name="extensions.noiawarmop.shadow" type="bool" instantApply="true"/>
      <preference id="scrollbarsRadio" name="extensions.noiawarmop.scrollbars" type="bool" instantApply="true"/>
      <preference id="closebuttonRadio" name="extensions.noiawarmop.closebutton" type="bool" instantApply="true"/>
      <preference id="nolineRadio" name="extensions.noiawarmop.noline" type="bool" instantApply="true"/>
      <preference id="tabbarRadio" name="extensions.noiawarmop.tabbar" type="bool" instantApply="true"/>
      <preference id="stripRadio" name="extensions.noiawarmop.strip" type="bool" instantApply="true"/>
      <preference id="tabbottomRadio" name="extensions.noiawarmop.tabbottom" type="bool" instantApply="true"/>
      <preference id="normalRadio" name="extensions.noiawarmop.normal" type="bool" instantApply="true"/>
      <preference id="hideRadio" name="extensions.noiawarmop.hide" type="bool" instantApply="true"/>
      <preference id="darkerRadio" name="extensions.noiawarmop.darker" type="bool" instantApply="true"/>
      <preference id="darker2Radio" name="extensions.noiawarmop.darker2" type="bool" instantApply="true"/>
      <preference id="lightRadio" name="extensions.noiawarmop.light" type="bool" instantApply="true"/>
      <preference id="warmRadio" name="extensions.noiawarmop.warm" type="bool" instantApply="true"/>
      <preference id="redRadio" name="extensions.noiawarmop.red" type="bool" instantApply="true"/>
      <preference id="red2Radio" name="extensions.noiawarmop.red2" type="bool" instantApply="true"/>
      <preference id="navbuttonsRadio" name="extensions.noiawarmop.navbuttons" type="bool" instantApply="true"/>
      <preference id="forwardRadio" name="extensions.noiawarmop.forward" type="bool" instantApply="true"/>
      <preference id="bfdropRadio" name="extensions.noiawarmop.bfdrop" type="bool" instantApply="true"/>
      <preference id="bfdrop2Radio" name="extensions.noiawarmop.bfdrop2" type="bool" instantApply="true"/>
      <preference id="bfdrop3Radio" name="extensions.noiawarmop.bfdrop3" type="bool" instantApply="true"/>
      <preference id="resetRadio" name="extensions.noiawarmop.reset" type="bool" instantApply="true"/>
      <preference id="navbarbuttonRadio" name="extensions.noiawarmop.navbarbutton" type="bool" instantApply="true"/>
      <preference id="folderColorPref" name="extensions.noiawarmop.folderColor" type="string" instantApply="true"/>
      <preference id="personalbuttonRadio" name="extensions.noiawarmop.personalbutton" type="bool" instantApply="true"/>
      <preference id="toolbarbuttonRadio" name="extensions.noiawarmop.toolbarbutton" type="bool" instantApply="true"/>
    </preferences>
    <vbox>
      <tabbox id="nftabbox2">
        <tabs>
          <tab label="&main;"   style="height:20px;" id="nftmain"/>
          <tab label="&tab;"   style="height:20px;" id="nfttab"/>
          <tab label="&rdbutton;"   style="height:20px;" id="nftrdbutton"/>
          <tab label="&icons;"   style="height:20px;" id="nfticons"/>
          <tab label="&Advanced;"   style="height:20px;" id="nftOptions"/>
          <tab label="Folders" style="height:20px;" id="nftFolders"/>
        </tabs>
        <tabpanels>
          <tabpanel id="panemain" orient="vertical">
            <groupbox id="noia-options-compatibility-warning">
              <caption label="Compatibility with Noia Moon Options"/>
              <description>Do not enable Noia Warm Moon Options and the original Noia Moon Options at the same time. Their XUL overlays and globally loaded styles can conflict.</description>
              <description>Both themes may remain installed. Enable only the Options add-on matching the active theme, then restart Pale Moon after switching.</description>
            </groupbox>
            <groupbox>
              <caption label="Theme appearance"/>
              <description>Default preserves the original Noia Warm Moon appearance. Only explicitly selected palettes change colors; other settings remain independent.</description>
              <radiogroup id="themeVariantPicker" orient="vertical" oncommand="noiawarmop.options.setThemeVariant(this.value);">
                <radio label="Default (Noia Warm Moon)" value="default" selected="true"/>
                <radio label="Bronze" value="bronze"/>
                <radio label="Soft Rose" value="rose"/>
                <radio label="Sage Green" value="sage"/>
                <radio label="Black (Experimental)" value="black"/>
              </radiogroup>
              <description id="themeVariantStatus" value="Alternative color themes require a Pale Moon restart."/>
            </groupbox>

            <groupbox>

              <hbox>
                <grid flex="1">
                  <columns>
                    <column flex="1" />
                    <column flex="1" />
                  </columns>

                  <rows>
                    <row>
                      <hbox align="center">
                        <checkbox label="&noline;" preference="nolineRadio" oncommand="if(this.checked) noiawarmop.options.radioChange(true,'noline'); else noiawarmop.options.radioChange(false,'noline');" tooltiptext="&tipnoline;"/>
                      </hbox>
                      <hbox align="center">
                        <checkbox label="&hide;" preference="hideRadio" oncommand="if(this.checked) noiawarmop.options.radioChange(true,'hide'); else noiawarmop.options.radioChange(false,'hide');" tooltiptext="&tiphide;"/>
                      </hbox>
                    </row>
                    <row>
                      <hbox align="center">
                        <checkbox label="&normal;" preference="normalRadio" oncommand="if(this.checked) noiawarmop.options.radioChange(true,'normal'); else noiawarmop.options.radioChange(false,'normal');" tooltiptext="&tipnormal;"/>
                      </hbox>
                      <hbox align="center">
                        <label value="&windowblinds;"/>
                      </hbox>

                    </row>
                    <row>
                      <hbox align="center">
                        <checkbox label="&tabbottom;" preference="tabbottomRadio" oncommand="if(this.checked) noiawarmop.options.radioChange(true,'tabbottom'); else noiawarmop.options.radioChange(false,'tabbottom');" tooltiptext=""/>
                      </hbox>
                      <hbox align="center">
                        <checkbox label="&scrollbars;" preference="scrollbarsRadio" oncommand="if(this.checked) noiawarmop.options.radioChange(true,'scrollbars'); else noiawarmop.options.radioChange(false,'scrollbars');"/>
                      </hbox>
                    </row>
                  </rows>
                </grid>
              </hbox>

              <separator class="groove"/>

              <hbox align="center">
                <checkbox label="&strip;" preference="stripRadio" oncommand="if(this.checked) noiawarmop.options.radioChange(true,'strip'); else noiawarmop.options.radioChange(false,'strip');" tooltiptext="&Blueandgrey;"/>
              </hbox>

              <separator class="groove"/>

              <vbox collapsed="true">
                <hbox align="center">
                  <checkbox label="&grey2;" preference="grey2Radio" oncommand="if(this.checked) noiawarmop.options.radioChange(true,'grey2'); else noiawarmop.options.radioChange(false,'grey2');" tooltiptext="&Grey;"/>
                </hbox>
                <hbox align="center">
                  <checkbox label="&tabbar;" preference="tabbarRadio" oncommand="if(this.checked) noiawarmop.options.radioChange(true,'tabbar'); else noiawarmop.options.radioChange(false,'tabbar');" tooltiptext="&Grey;"/>
                </hbox>
                <hbox align="center">
                  <checkbox label="&darker;" preference="darkerRadio" oncommand="if(this.checked) noiawarmop.options.radioChange(true,'darker'); else noiawarmop.options.radioChange(false,'darker');" tooltiptext="&Grey;"/>
                </hbox>
                <hbox align="center">
                  <checkbox label="&darker2;" preference="darker2Radio" oncommand="if(this.checked) noiawarmop.options.radioChange(true,'darker2'); else noiawarmop.options.radioChange(false,'darker2');" tooltiptext="&Grey;"/>
                </hbox>
              </vbox>
            </groupbox>

          </tabpanel>
          <tabpanel id="panetab" orient="vertical">
            <groupbox>
              <label value="&browsertab;" style="font-weight:bold;"/>

              <radiogroup id="rdtabRadio" orient="horizontal" value="" style="border-width:0px;border-style:solid;margin-bottom:1px;">
                <radio label="&rdtabEnable;" value="1" onmousedown="noiawarmop.options.radioChange(true,'rdtab');this.parentNode.selectedIndex = 1"/>
                <radio label="&rdtabDisable;" value="0" style="display: none;" onmousedown="noiawarmop.options.radioChange(false,'rdtab');this.parentNode.selectedIndex = 0"/>
                <label value="&rdtab;" style="display: none;margin-top:4px;"/>
              </radiogroup>

              <radiogroup id="SemiRoundedtabRadio" orient="horizontal" value="" style="border-width:0px;border-style:solid;margin-bottom:1px;">
                <radio label="&SemiRoundedtabEnable;" value="1" onmousedown="noiawarmop.options.radioChange(true,'semiroundedtab');this.parentNode.selectedIndex = 1"/>
                <radio label="&SemiRoundedtabDisable;" value="0" style="display: none;" onmousedown="noiawarmop.options.radioChange(false,'semiroundedtab');this.parentNode.selectedIndex = 0"/>
                <label value="&SemiRoundedtab;" style="display: none;margin-top:4px;"/>
              </radiogroup>

              <radiogroup id="sqtabRadio" orient="horizontal" value="" style="border-width:0px;border-style:solid;margin-bottom:1px;">
                <radio label="&sqtabEnable;" value="1" onmousedown="noiawarmop.options.radioChange(true,'sqtab');this.parentNode.selectedIndex = 1"/>
                <radio label="&sqtabDisable;" value="0" style="display: none;" onmousedown="noiawarmop.options.radioChange(false,'sqtab');this.parentNode.selectedIndex = 0"/>
                <label value="&sqtab;" style="display: none;margin-top:4px;"/>
              </radiogroup>
              <hbox align="center">
                <checkbox label="&solidtab;" preference="solidRadio" oncommand="if(this.checked) noiawarmop.options.radioChange(true,'solid'); else noiawarmop.options.radioChange(false,'solid');"/>
              </hbox>
              <hbox align="center">
                <checkbox label="&shadow;" preference="shadowRadio" oncommand="if(this.checked) noiawarmop.options.radioChange(true,'shadow'); else noiawarmop.options.radioChange(false,'shadow');" tooltiptext="&tipshadow;"/>
              </hbox>
              <separator class="groove"/>
              <label value="&rdtabbox;" style="margin-top:4px;font-weight:bold;"/>
              <hbox align="center">
                <radiogroup id="rdtabboxRadio" orient="vertical" value="" style="border-width:0px;border-style:solid;margin-bottom:1px;">
                  <radio label="&rdtabboxEnable;" tooltiptext="" value="1" onmousedown="noiawarmop.options.radioChange(true,'rdtabbox');this.parentNode.selectedIndex = 1"/>
                  <radio label="&rdtabboxDisable;" value="0" onmousedown="noiawarmop.options.radioChange(false,'rdtabbox');this.parentNode.selectedIndex = 0"/>
                </radiogroup>
              </hbox>
            </groupbox>
          </tabpanel>

          <tabpanel id="panebuttons" orient="vertical">
            <groupbox>
              <label value="&buttonstyle;" style="margin-top:4px;font-weight:bold;"/>
              <hbox align="center">
                <radiogroup id="rdbuttonRadio" orient="vertical" value="" style="border-width:0px;border-style:solid;margin-bottom:1px;">
                  <radio label="&rdbuttonEnable;" tooltiptext="" value="1" onmousedown="noiawarmop.options.radioChange(true,'rdbutton');this.parentNode.selectedIndex = 1"/>
                  <radio label="&rdbuttonDisable;" value="0" onmousedown="noiawarmop.options.radioChange(false,'rdbutton');this.parentNode.selectedIndex = 0"/>
                </radiogroup>
              </hbox>
              <separator class="groove"/>
              <label value="&menubuttonstyle;" style="margin-top:4px;font-weight:bold;"/>
              <hbox align="center">
                <radiogroup id="rdmenubuttonRadio" orient="vertical" value="" style="border-width:0px;border-style:solid;margin-bottom:1px;">
                  <radio label="&rdmenubuttonEnable;" tooltiptext="" value="1" onmousedown="noiawarmop.options.radioChange(true,'rdmenubutton');this.parentNode.selectedIndex = 1"/>
                  <radio label="&rdmenubuttonDisable;" value="0" onmousedown="noiawarmop.options.radioChange(false,'rdmenubutton');this.parentNode.selectedIndex = 0"/>
                </radiogroup>
              </hbox>
              <separator class="groove"/>
              <label value="&closestyle;" style="margin-top:4px;font-weight:bold;"/>
              <hbox align="center">
                <checkbox label="&closebutton;" preference="closebuttonRadio" oncommand="if(this.checked) noiawarmop.options.radioChange(true,'closebutton'); else noiawarmop.options.radioChange(false,'closebutton');" />
              </hbox>
            </groupbox>
          </tabpanel>

          <tabpanel id="paneIcons" orient="vertical">
            <vbox>
              <groupbox>
                <description>Toolbar icon sizes and navigation dropmarkers</description>
                <hbox align="center">
                  <checkbox label="&navbuttons;" preference="navbuttonsRadio" oncommand="if(this.checked) noiawarmop.options.radioChange(true,'navbuttons'); else noiawarmop.options.radioChange(false,'navbuttons');"/>
                </hbox>
                <hbox align="center">
                  <checkbox label="&forward;" preference="forwardRadio" oncommand="if(this.checked) noiawarmop.options.radioChange(true,'forward'); else noiawarmop.options.radioChange(false,'forward');"/>
                </hbox>
                
                <separator class="groove"/>
                
                <hbox align="center">
                  <checkbox label="&bfdrop;" preference="bfdropRadio" oncommand="if(this.checked) noiawarmop.options.radioChange(true,'bfdrop'); else noiawarmop.options.radioChange(false,'bfdrop');"/>
                </hbox>
                <hbox align="center">
                  <checkbox label="&bfdrop2;" preference="bfdrop2Radio" oncommand="if(this.checked) noiawarmop.options.radioChange(true,'bfdrop2'); else noiawarmop.options.radioChange(false,'bfdrop2');"/>
                </hbox>
                <hbox align="center">
                  <checkbox label="&bfdrop3;" preference="bfdrop3Radio" oncommand="if(this.checked) noiawarmop.options.radioChange(true,'bfdrop3'); else noiawarmop.options.radioChange(false,'bfdrop3');"/>
                </hbox>
              </groupbox>

            </vbox>
          </tabpanel>

          <tabpanel id="paneAdvanced" orient="vertical">
            <groupbox>
              <label value="&bookmark;" style="font-weight:bold;"/>
              <hbox align="center">
                <radiogroup id="bookmarkRadio" orient="vertical" value="" style="border-width:0px;border-style:solid;margin-bottom:1px;">
                  <radio label="&bookEnable;" value="1" onmousedown="noiawarmop.options.radioChange(true,'bookmark');this.parentNode.selectedIndex = 1"/>
                  <radio label="&bookDisable;" value="0" onmousedown="noiawarmop.options.radioChange(false,'bookmark');this.parentNode.selectedIndex = 0"/>
                  <label value="&bookmark;" style="margin-top:4px;display:none;"/>
                </radiogroup>
              </hbox>

              <separator class="groove"/>

              <label value="&addon;" style="font-weight:bold;"/>
              <hbox align="center">
                <radiogroup id="addonRadio" orient="vertical" value="" style="border-width:0px;border-style:solid;margin-bottom:1px;">
                  <radio label="&addonEnable;" value="1" onmousedown="noiawarmop.options.radioChange(true,'addon');this.parentNode.selectedIndex = 1"/>
                  <radio label="&addonDisable;" value="0" onmousedown="noiawarmop.options.radioChange(false,'addon');this.parentNode.selectedIndex = 0"/>
                  <label value="&addon;" style="margin-top:4px;display:none;"/>
                </radiogroup>
              </hbox>

              <separator class="groove"/>

              <label value="&personalbuttontitle;" style="font-weight:bold;"/>
              <hbox align="center">
                <checkbox label="&personalbuttonEnable;" tooltiptext="&tippersonalbuttonEnable;" preference="personalbuttonRadio" oncommand="if(this.checked) noiawarmop.options.radioChange(true,'personalbutton'); else noiawarmop.options.radioChange(false,'personalbutton');"/>
              </hbox>

              <separator class="groove"/>

              <label value="&toolbarbuttontitle;" style="font-weight:bold;"/>
              <hbox align="center">
                <checkbox label="&toolbarbuttonEnable;" tooltiptext="&tiptoolbarbuttonEnable;" preference="toolbarbuttonRadio" oncommand="if(this.checked) noiawarmop.options.radioChange(true,'toolbarbutton'); else noiawarmop.options.radioChange(false,'toolbarbutton');"/>
              </hbox>

              <separator class="groove"/>

              <label value="&navbarbuttontitle;" style="font-weight:bold;"/>
              <hbox align="center">
                <checkbox label="&navbarbuttonEnable;" tooltiptext="" preference="navbarbuttonRadio" oncommand="if(this.checked) noiawarmop.options.radioChange(true,'navbarbutton'); else noiawarmop.options.radioChange(false,'navbarbutton');"/>
              </hbox>
            </groupbox>
            <button label="&reset;" oncommand="noiawarmop.options.resetnm();alert('&restartPM;');"/>
          </tabpanel>
          <tabpanel id="paneFolderColors" orient="vertical">
            <groupbox>
              <caption label="Bookmarks Sidebar folder colors"/>
              <description>Choose the folder color for Bookmarks Sidebar, Library, and Bookmarks Toolbar. Changes take effect after restarting Pale Moon. Download Manager icons are not changed.</description>
              <separator class="thin"/>
              <hbox align="center">
                <label value="Folder color:" control="folderColorPicker"/>
                <menulist id="folderColorPicker" preference="folderColorPref"
                          oncommand="noiawarmop.options.setFolderColor(this.value);">
                  <menupopup>
                    <menuitem label="Red (default)" value="red"/>
                    <menuitem label="Yellow" value="yellow"/>
                    <menuitem label="Violet" value="violet"/>
                    <menuitem label="Orange" value="orange"/>
                    <menuitem label="Grey" value="grey"/>
                    <menuitem label="Green" value="green"/>
                    <menuitem label="Cyan" value="cyan"/>
                    <menuitem label="Blue" value="blue"/>
                  </menupopup>
                </menulist>
              </hbox>
              <description id="folderColorStatus" value=""/>
              <description>For full legacy options compatibility, test each original option separately. No legacy color override is enabled by default.</description>
            </groupbox>
          </tabpanel>
        </tabpanels>
      </tabbox>
    </vbox>
  </prefpane>
</prefwindow>
